    "mnl_records":  { ".read": "auth != null", "$id": { ".write": "auth != null", ".validate": "!newData.exists() || newData.hasChild('id')" } },
    "arb_records":  { ".read": "auth != null", "$id": { ".write": "auth != null", ".validate": "!newData.exists() || newData.hasChild('id')" } },
    "sal_records":  { ".read": "auth != null", "$id": { ".write": "auth != null", ".validate": "!newData.exists() || newData.hasChild('id')" } },
