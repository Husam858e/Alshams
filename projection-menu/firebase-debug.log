[debug] [2026-10-18T16:32:41.795Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-pm:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n\n// Security rules of the restaurant's Firebase project (cloud mode).\n// Layout and roles: docs/cloud-architecture.md (\"Firestore layout\").\n//\n//   staff     Firebase Auth email accounts; roles/{uid} = {role, userId, active}\n//             is the only source of a role (staff cannot write it, only owners)\n//   projector anonymous Auth accounts bound to one projector by devices/{uid},\n//             which only a valid, unexpired pairing code can create\n//\n// Deactivated staff and anonymous visitors that are not a paired projector\n// read nothing but the public bits (setup state, restaurant name and theme).\n//\n// Every rule below states who may do what; the app checks the same things\n// first so that people get a clear Arabic message instead of a refusal.\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // ── Who is asking ─────────────────────────────────────────────\n\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function docPath(collection, id) {\n      return /databases/$(database)/documents/$(collection)/$(id);\n    }\n\n    // The caller's role, or 'none' (signed out, no account, deactivated).\n    function role() {\n      return signedIn() ? roleOf(request.auth.uid) : 'none';\n    }\n\n    function roleOf(uid) {\n      let roles = docPath('roles', uid);\n      return exists(roles) && get(roles).data.active == true ? get(roles).data.role : 'none';\n    }\n\n    function isOwner() { return role() == 'owner'; }\n    function isDesigner() { return role() == 'designer'; }\n    function isWaiter() { return role() == 'waiter'; }\n    function isStaff() { return role() in ['owner', 'designer', 'waiter']; }\n    function isContentTeam() { return role() in ['owner', 'designer']; }\n    function isFloorTeam() { return role() in ['owner', 'waiter']; }\n\n    // users/{id} of the signed-in staff member.\n    function myUserId() {\n      return get(docPath('roles', request.auth.uid)).data.userId;\n    }\n\n    // The projector this (anonymous) device is bound to, or -1. \"After\":\n    // as it will be once the current batch is written (the claim creates it).\n    function boundProjectorAfter() {\n      return signedIn() ? projectorOfDeviceAfter(request.auth.uid) : -1;\n    }\n\n    function projectorOfDeviceAfter(uid) {\n      let device = docPath('devices', uid);\n      return existsAfter(device) ? getAfter(device).data.projectorId : -1;\n    }\n\n    // A projector device that completed its pairing.\n    function isBoundDevice() {\n      return signedIn() && exists(docPath('devices', request.auth.uid));\n    }\n\n    // Active staff and paired projectors: who may read the restaurant's\n    // floor and menu (not any visitor who signs in anonymously).\n    function isMember() {\n      return isStaff() || isBoundDevice();\n    }\n\n    // The table of the projector this device is bound to, or -1.\n    function boundTable() {\n      return signedIn() ? tableOfDevice(request.auth.uid) : -1;\n    }\n\n    function tableOfDevice(uid) {\n      let device = docPath('devices', uid);\n      return exists(device) ? tableOfProjector(get(device).data.projectorId) : -1;\n    }\n\n    function tableOfProjector(projectorId) {\n      let projector = docPath('projectors', string(projectorId));\n      return exists(projector) ? get(projector).data.table_id : -1;\n    }\n\n    // ── Helpers ───────────────────────────────────────────────────\n\n    function data() { return request.resource.data; }\n\n    // Top-level fields an update changes.\n    function changed() {\n      return request.resource.data.diff(resource.data).affectedKeys();\n    }\n\n    function onlyChanges(fields) {\n      return changed().hasOnly(fields);\n    }\n\n    // A document's own `id` field matches its document id.\n    function idMatches(id) {\n      return data().id is int && string(data().id) == id;\n    }\n\n    // The first owner's setup batch: meta/setup does not exist before it,\n    // and names the caller once the batch is written.\n    function bootstrapping() {\n      let setup = docPath('meta', 'setup');\n      return signedIn()\n        && !exists(setup)\n        && existsAfter(setup)\n        && getAfter(setup).data.ownerUid == request.auth.uid;\n    }\n\n    // ── meta: first run and id counters ───────────────────────────\n\n    // Exists once the owner account exists (the app shows \"create owner\" until then).\n    match /meta/setup {\n      allow get: if true;\n      allow create: if signedIn()\n        && data().keys().hasOnly(['ownerUid', 'at'])\n        && data().ownerUid == request.auth.uid\n        && getAfter(docPath('roles', request.auth.uid)).data.role == 'owner';\n      allow list, update, delete: if false;\n    }\n\n    // One counter per kind of id; staff reserve ids by raising them (never lowering).\n    match /meta/counters {\n      function notLower(kind) {\n        return data().get(kind, 0) is int && data().get(kind, 0) >= resource.data.get(kind, 0);\n      }\n      function validCounters() {\n        return data().keys().hasOnly(['user', 'area', 'table', 'projector', 'asset', 'category', 'dish', 'order', 'activity']);\n      }\n      allow get: if isStaff();\n      allow create: if bootstrapping() && validCounters();\n      allow update: if isStaff() && validCounters()\n        && notLower('user') && notLower('area') && notLower('table') && notLower('projector')\n        && notLower('asset') && notLower('category') && notLower('dish') && notLower('order')\n        && notLower('activity');\n      allow list, delete: if false;\n    }\n\n    // ── Accounts ──────────────────────────────────────────────────\n\n    // username -> current Auth email. Read one by one before signing in; never listed.\n    match /logins/{key} {\n      allow get: if true;\n      allow list: if false;\n      allow create, update: if (isOwner() || bootstrapping())\n        && data().keys().hasOnly(['email', 'userId'])\n        && data().email is string\n        && data().userId is int;\n      allow delete: if isOwner();\n    }\n\n    // The security source of truth. Only owners write roles (nobody raises\n    // their own); the first owner writes their own once, during setup.\n    match /roles/{uid} {\n      function validRole() {\n        return data().keys().hasOnly(['role', 'userId', 'active'])\n          && data().role in ['owner', 'designer', 'waiter']\n          && data().userId is int\n          && data().active is bool;\n      }\n      allow get: if signedIn() && (uid == request.auth.uid || isOwner());\n      allow list: if isOwner();\n      allow create: if validRole()\n        && (isOwner() || (bootstrapping() && uid == request.auth.uid && data().role == 'owner' && data().active == true));\n      allow update: if validRole() && isOwner();\n      allow delete: if isOwner();\n    }\n\n    // The app's user rows (no passwords: Auth holds them).\n    match /users/{id} {\n      function validUser() {\n        return idMatches(id) && !('password' in data()) && data().role in ['owner', 'designer', 'waiter'];\n      }\n      allow read: if isStaff();\n      allow create: if validUser() && (isOwner() || (bootstrapping() && id == '1' && data().role == 'owner'));\n      // Everyone records their own last sign-in; everything else is the owner's.\n      allow update: if validUser()\n        && (isOwner() || (isStaff() && string(myUserId()) == id && onlyChanges(['last_login_at'])));\n      allow delete: if false;\n    }\n\n    // ── Floor ─────────────────────────────────────────────────────\n\n    match /areas/{id} {\n      allow read: if isMember();\n      allow create, update: if isOwner() && idMatches(id);\n      allow delete: if isOwner();\n    }\n\n    // Waiters only change a table's status (free / occupied / reserved).\n    match /tables/{id} {\n      allow read: if isMember();\n      allow create: if isOwner() && idMatches(id);\n      allow update: if (isOwner() && idMatches(id))\n        || (isWaiter() && onlyChanges(['status']) && data().status in ['free', 'occupied', 'reserved']);\n      allow delete: if isOwner();\n    }\n\n    // Owners manage projectors; designers calibrate them; the bound device\n    // writes only its heartbeat, scene acks and power, and completes its\n    // own pairing (pending -> false, device_uid = itself).\n    match /projectors/{id} {\n      function deviceUpdate() {\n        return boundProjectorAfter() == int(id)\n          && onlyChanges(['last_seen_at', 'acked_at', 'power', 'pending', 'device_uid'])\n          && data().get('pending', false) == false\n          && data().get('device_uid', null) == request.auth.uid;\n      }\n      allow read: if isMember();\n      allow create: if isOwner() && idMatches(id);\n      allow update: if (isOwner() && idMatches(id))\n        || (isDesigner() && onlyChanges(['calibration', 'rotation', 'layout', 'test_pattern']))\n        || deviceUpdate();\n      allow delete: if isOwner();\n    }\n\n    // A device's binding to its projector. Created only with a pairing code\n    // that exists, has not expired, names that projector and is deleted in\n    // the same batch (single use). The owner deletes it to cut the device off.\n    match /devices/{uid} {\n      function validClaim() {\n        let pairing = docPath('pairing', data().code);\n        return data().keys().hasOnly(['projectorId', 'code', 'at'])\n          && data().code is string\n          && exists(pairing)\n          && get(pairing).data.projectorId == data().projectorId\n          && get(pairing).data.expiresAt > request.time\n          && !existsAfter(pairing);\n      }\n      allow get: if signedIn() && (uid == request.auth.uid || isOwner());\n      allow list: if isOwner();\n      allow create, update: if signedIn() && uid == request.auth.uid && validClaim();\n      allow delete: if isOwner();\n    }\n\n    // 6-digit pairing codes (10 minutes, single use). Read one by one.\n    match /pairing/{code} {\n      function validPairing() {\n        return code.matches('^[0-9]{6}$')\n          && data().keys().hasOnly(['projectorId', 'tableId', 'expiresAt', 'createdBy'])\n          && data().projectorId is int\n          && data().expiresAt is timestamp;\n      }\n      allow get: if signedIn();\n      allow list: if isOwner();\n      allow create, update: if isOwner() && validPairing();\n      // The owner, or the device that claims it in its pairing batch.\n      allow delete: if isOwner()\n        || (signedIn() && existsAfter(docPath('devices', request.auth.uid)) && getAfter(docPath('devices', request.auth.uid)).data.code == code);\n    }\n\n    // ── Menu, media, settings ─────────────────────────────────────\n\n    match /categories/{id} {\n      allow read: if isMember();\n      allow create, update: if isContentTeam() && idMatches(id);\n      allow delete: if isContentTeam();\n    }\n\n    // Prices are the owner's: a designer never changes one, and adds dishes at price 0.\n    match /dishes/{id} {\n      allow read: if isMember();\n      allow create: if idMatches(id) && data().price is number\n        && (isOwner() || (isDesigner() && data().price == 0));\n      allow update: if idMatches(id) && data().price is number\n        && (isOwner() || (isDesigner() && !('price' in changed())));\n      allow delete: if isContentTeam();\n    }\n\n    match /media/{id} {\n      allow read: if isMember();\n      allow create, update: if isContentTeam() && idMatches(id);\n      allow delete: if isContentTeam();\n    }\n\n    // Public: the restaurant's name and theme are shown on every table (and\n    // on the sign-in screen). general: owner; theme: owner and designer.\n    match /settings/{name} {\n      allow read: if true;\n      allow create, update: if (name == 'general' && (isOwner() || bootstrapping()))\n        || (name == 'theme' && (isContentTeam() || bootstrapping()));\n      allow delete: if false;\n    }\n\n    // What each table shows. Designers test with menu scenes, never orders.\n    match /scenes/{tableId} {\n      allow read: if isMember();\n      allow create, update: if isStaff()\n        && data().type in ['welcome', 'menu', 'category', 'dish', 'order', 'off']\n        && !(isDesigner() && data().type == 'order');\n      allow delete: if isStaff();\n    }\n\n    // ── Orders and the activity log ───────────────────────────────\n\n    // Owners and waiters; a projector reads the orders of its own table\n    // (one by one: the order its table shows).\n    match /orders/{id} {\n      allow read: if isFloorTeam() || resource.data.table_id == boundTable();\n      allow create, update: if isFloorTeam() && idMatches(id);\n      allow delete: if false;\n    }\n\n    // Append-only; everyone logs as themselves; only owners read it.\n    match /activity/{id} {\n      allow read: if isOwner();\n      allow create: if idMatches(id)\n        && ((isStaff() && data().user_id == myUserId())\n          || (bootstrapping() && data().action == 'auth.setup'));\n      allow update, delete: if false;\n    }\n  }\n}\n"}]}}
