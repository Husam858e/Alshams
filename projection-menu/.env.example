# انسخ هذا الملف إلى .env ثم شغّل: npm run start:env  (أو صدّر المتغيرات قبل npm start)
PORT=3000
HOST=0.0.0.0

# رمز دخول لوحة التحكم — غيّره!
ADMIN_TOKEN=change-me

# العنوان الذي تصل به الأجهزة (التابلت، أجهزة العرض، وكيل Raspberry Pi) إلى الخادم.
# يُستخدم في روابط الربط ورموز QR. الافتراضي: أول IP للخادم على الشبكة المحلية + PORT.
# PUBLIC_BASE_URL=http://192.168.1.10:3000

# العملة المعروضة على التابلت
CURRENCY=د.ع

# DB_PATH=./data/menu.db
# MEDIA_DIR=./data/media
# MAX_UPLOAD_MB=500
# تطبيق أندرويد الذي تنزّله الأجهزة من /app.apk
# APK_PATH=./dist/ProjectionMenu.apk
# CUE_ACK_TIMEOUT_MS=3000
# AGENT_ONLINE_WINDOW_MS=30000
