# انسخ هذا الملف إلى .env ثم شغّل: npm run start:env  (أو صدّر المتغيرات قبل npm start)
PORT=3000
HOST=0.0.0.0

# العنوان الذي تصل به الأجهزة (التابلت وأجهزة العرض) إلى الخادم، ويظهر في روابط
# الربط ورموز QR. الافتراضي: أول IP للخادم على الشبكة المحلية + PORT.
# PUBLIC_BASE_URL=http://192.168.1.10:3000

# الإعلان عن الخادم على الشبكة المحلية (mDNS: _projection-menu._tcp) ليجده تطبيق
# أندرويد تلقائياً. اجعله 0 لتعطيله.
MDNS=1

# مدة بقاء تسجيل الدخول بالأيام (تتجدد مع الاستخدام).
# SESSION_DAYS=30

# DB_PATH=./data/menu.db
# MEDIA_DIR=./data/media
# الحد الأقصى لحجم الملف المرفوع (ميغابايت)
# MAX_UPLOAD_MB=500
# تطبيق أندرويد الذي تنزّله الأجهزة من /app.apk
# APK_PATH=./dist/ProjectionMenu.apk
# مهلة انتظار تأكيد جهاز العرض لاستلام المشهد (ملّي ثانية)
# SCENE_ACK_TIMEOUT_MS=2000
